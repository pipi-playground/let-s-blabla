# Supabase 프로젝트 설정 (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=xxxxxxxxxxxxxxxxxxxx
# 서버 전용! 절대 클라이언트에 노출/커밋 금지
SUPABASE_SERVICE_ROLE_KEY=xxxxxxxxxxxxxxxxxxxx

# 웹푸시 VAPID 키 (npx web-push generate-vapid-keys 로 생성)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=xxxxxxxxxxxxxxxxxxxx
VAPID_PRIVATE_KEY=xxxxxxxxxxxxxxxxxxxx
VAPID_SUBJECT=mailto:you@example.com
